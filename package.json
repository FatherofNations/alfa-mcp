{
  "name": "alfa-mcp",
  "version": "0.8.1",
  "description": "MCP-сервер для скоростной разработки интерактивных прототипов по Figma-макетам: база знаний, скаффолд, пайплайн ассетов, канон анимаций",
  "license": "MIT",
  "type": "module",
  "bin": {
    "alfa-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "knowledge",
    "template",
    "template-static",
    "blocks",
    "brand",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/server.js', 0o755)\"",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run build && node test/smoke.mjs && node test/smoke-http.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "sharp": "^0.35.3",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
